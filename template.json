{
 "name": "Plane v1 Project Hub",
 "description": "Issues, sprints, docs and roadmaps for your team. Full Plane stack, no seat fees.",
 "category": "Other",
 "tags": [
  "plane",
  "project-management",
  "issues",
  "jira-alternative",
  "linear-alternative",
  "kanban"
 ],
 "upstream": {
  "repo": "makeplane/plane",
  "version": "v1.4.2",
  "checked": "2026-10-10"
 },
 "services": {
  "proxy": {
   "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/caddy.svg",
   "source": {
    "repo": "baranberkay96/plane-railway",
    "rootDirectory": "/services/proxy"
   },
   "startCommand": null,
   "preDeployCommand": null,
   "healthcheckPath": "/proxy-health",
   "healthcheckTimeout": 60,
   "restartPolicyType": "ON_FAILURE",
   "restartPolicyMaxRetries": 10,
   "numReplicas": 1,
   "cronSchedule": null,
   "publicDomain": true,
   "targetPort": 8080,
   "tcpProxy": null,
   "volume": null,
   "variables": {
    "PORT": {
     "defaultValue": "8080",
     "description": "Port Caddy listens on (public domain target).",
     "required": false
    },
    "WEB_UPSTREAM": {
     "defaultValue": "${{web.RAILWAY_PRIVATE_DOMAIN}}:3000",
     "description": "Main web app.",
     "required": false
    },
    "SPACE_UPSTREAM": {
     "defaultValue": "${{space.RAILWAY_PRIVATE_DOMAIN}}:3000",
     "description": "Public spaces (/spaces).",
     "required": false
    },
    "ADMIN_UPSTREAM": {
     "defaultValue": "${{admin.RAILWAY_PRIVATE_DOMAIN}}:3000",
     "description": "Instance admin (/god-mode).",
     "required": false
    },
    "LIVE_UPSTREAM": {
     "defaultValue": "${{live.RAILWAY_PRIVATE_DOMAIN}}:3000",
     "description": "Live collaboration server (/live).",
     "required": false
    },
    "API_UPSTREAM": {
     "defaultValue": "${{api.RAILWAY_PRIVATE_DOMAIN}}:8000",
     "description": "API (/api, /auth, /static).",
     "required": false
    },
    "FILE_SIZE_LIMIT": {
     "defaultValue": "${{api.FILE_SIZE_LIMIT}}",
     "description": "Max request body size in bytes (same as api).",
     "required": false
    }
   }
  },
  "web": {
   "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/plane.svg",
   "source": {
    "image": "makeplane/plane-frontend:v1.4.2"
   },
   "startCommand": "/bin/sh -c \"sed -i -e 's/^worker_processes .*/worker_processes 2;/' -e 's/listen 3000;/listen 3000; listen [::]:3000;/' /etc/nginx/nginx.conf && nginx -t && exec nginx -g 'daemon off;'\"",
   "preDeployCommand": null,
   "healthcheckPath": "/",
   "healthcheckTimeout": 120,
   "restartPolicyType": "ON_FAILURE",
   "restartPolicyMaxRetries": 10,
   "numReplicas": 1,
   "cronSchedule": null,
   "publicDomain": false,
   "targetPort": null,
   "tcpProxy": null,
   "volume": null,
   "variables": {
    "PORT": {
     "defaultValue": "3000",
     "description": "Port the app listens on (private network; proxy target).",
     "required": false
    }
   }
  },
  "admin": {
   "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/plane.svg",
   "source": {
    "image": "makeplane/plane-admin:v1.4.2"
