  "api": {
   "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/plane.svg",
   "source": {
    "image": "makeplane/plane-backend:v1.4.2"
   },
   "startCommand": "/bin/bash -c \"sed 's/--bind 0.0.0.0:/--bind [::]:/' ./bin/docker-entrypoint-api.sh > /tmp/docker-entrypoint-api.sh && exec bash /tmp/docker-entrypoint-api.sh\"",
   "preDeployCommand": "/bin/bash -c \"python manage.py wait_for_db && python manage.py migrate --noinput\"",
   "healthcheckPath": "/api/instances/",
   "healthcheckTimeout": 600,
   "restartPolicyType": "ON_FAILURE",
   "restartPolicyMaxRetries": 10,
   "numReplicas": 1,
   "cronSchedule": null,
   "publicDomain": false,
   "targetPort": null,
   "tcpProxy": null,
   "volume": null,
   "variables": {
    "PORT": {
     "defaultValue": "8000",
     "description": "Gunicorn port (private network; proxy target).",
     "required": false
    },
    "GUNICORN_WORKERS": {
     "defaultValue": "2",
     "description": "Gunicorn/uvicorn worker processes for the API.",
     "required": false
    },
    "DEBUG": {
     "defaultValue": "0",
     "description": "Django debug mode off.",
     "required": false
    },
    "WEB_URL": {
     "defaultValue": "https://${{proxy.RAILWAY_PUBLIC_DOMAIN}}",
     "description": "Public URL of Plane (e-mail links, redirects). Update with a custom domain.",
     "required": false
    },
    "CORS_ALLOWED_ORIGINS": {
     "defaultValue": "https://${{proxy.RAILWAY_PUBLIC_DOMAIN}}",
     "description": "Allowed browser origins; also used as CSRF trusted origins. Comma-separate extra domains.",
     "required": false
    },
    "SECRET_KEY": {
     "defaultValue": "${{secret(64)}}",
     "description": "Django signing key (sessions, CSRF, password reset). Do not change after first boot.",
     "required": false
    },
    "LIVE_SERVER_SECRET_KEY": {
     "defaultValue": "${{secret(64)}}",
     "description": "Shared secret between api and the live (collaboration) server.",
     "required": false
    },
    "DATABASE_URL": {
     "defaultValue": "${{Postgres.DATABASE_URL}}",
     "description": "Postgres connection string (private network).",
     "required": false
    },
    "REDIS_URL": {
     "defaultValue": "${{Redis.REDIS_URL}}",
     "description": "Redis for cache and sessions.",
     "required": false
    },
    "AMQP_URL": {
     "defaultValue": "${{RabbitMQ.AMQP_URL}}",
     "description": "RabbitMQ broker for Celery jobs.",
     "required": false
    },
    "USE_MINIO": {
     "defaultValue": "0",
     "description": "0 = external S3 (Railway Bucket); browsers upload and download with presigned URLs.",
     "required": false
    },
    "AWS_S3_ENDPOINT_URL": {
     "defaultValue": "${{Bucket.ENDPOINT}}",
     "description": "S3 endpoint (Railway Bucket).",
     "required": false
    },
    "AWS_REGION": {
     "defaultValue": "${{Bucket.REGION}}",
     "description": "Bucket region (Railway Bucket).",
     "required": false
    },
    "AWS_DEFAULT_REGION": {
     "defaultValue": "${{Bucket.REGION}}",
     "description": "Region for boto3 clients created without an explicit region.",
     "required": false
    },
    "AWS_S3_BUCKET_NAME": {
     "defaultValue": "${{Bucket.BUCKET}}",
     "description": "Bucket name (Railway Bucket).",
     "required": false
    },
    "AWS_ACCESS_KEY_ID": {
     "defaultValue": "${{Bucket.ACCESS_KEY_ID}}",
     "description": "Bucket access key.",
     "required": false
    },
    "AWS_SECRET_ACCESS_KEY": {
     "defaultValue": "${{Bucket.SECRET_ACCESS_KEY}}",
     "description": "Bucket secret key.",
     "required": false
    },
    "FILE_SIZE_LIMIT": {
     "defaultValue": "5242880",
     "description": "Max upload size in bytes (5 MB, Plane default). Also enforced by the proxy.",
     "required": false
    },
    "API_KEY_RATE_LIMIT": {
     "defaultValue": "60/minute",
     "description": "Throttle for API-key requests.",
     "required": false
    },
    "AUTHENTICATION_RATE_LIMIT": {
     "defaultValue": "10/minute",
     "description": "Per-IP throttle for anonymous sign-in / magic-link endpoints.",
     "required": false
    }
   }
  },
  "worker": {
   "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/plane.svg",
   "source": {
    "image": "makeplane/plane-backend:v1.4.2"
