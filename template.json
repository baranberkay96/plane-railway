   "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/aws.svg",
   "source": {
    "image": "amazon/aws-cli:2.37.12"
   },
   "startCommand": "/bin/sh -c \"aws s3api put-bucket-cors --bucket $BUCKET_NAME --endpoint-url $S3_ENDPOINT --region $S3_REGION --cors-configuration \\\"$CORS_CONFIGURATION\\\" && echo 'Bucket CORS configured for' $PUBLIC_ORIGIN\"",
   "preDeployCommand": null,
   "healthcheckPath": null,
   "healthcheckTimeout": null,
   "restartPolicyType": "NEVER",
   "restartPolicyMaxRetries": null,
   "numReplicas": 1,
   "cronSchedule": null,
   "publicDomain": false,
   "targetPort": null,
   "tcpProxy": null,
   "volume": null,
   "variables": {
    "AWS_ACCESS_KEY_ID": {
     "defaultValue": "${{Bucket.ACCESS_KEY_ID}}",
     "description": "Bucket access key.",
