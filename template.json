    },
    "AWS_SECRET_ACCESS_KEY": {
     "defaultValue": "${{Bucket.SECRET_ACCESS_KEY}}",
     "description": "Bucket secret key.",
     "required": false
    },
    "BUCKET_NAME": {
     "defaultValue": "${{Bucket.BUCKET}}",
     "description": "Bucket to configure.",
     "required": false
    },
    "S3_ENDPOINT": {
     "defaultValue": "${{Bucket.ENDPOINT}}",
     "description": "Bucket S3 endpoint.",
     "required": false
    },
    "S3_REGION": {
     "defaultValue": "${{Bucket.REGION}}",
     "description": "Bucket region.",
     "required": false
    },
    "PUBLIC_ORIGIN": {
     "defaultValue": "https://${{proxy.RAILWAY_PUBLIC_DOMAIN}}",
     "description": "Plane's public origin (for the log line).",
     "required": false
    },
    "CORS_CONFIGURATION": {
     "defaultValue": "{\"CORSRules\":[{\"AllowedOrigins\":[\"https://${{proxy.RAILWAY_PUBLIC_DOMAIN}}\"],\"AllowedMethods\":[\"GET\",\"HEAD\",\"PUT\",\"POST\"],\"AllowedHeaders\":[\"*\"],\"ExposeHeaders\":[\"ETag\"],\"MaxAgeSeconds\":3600}]}",
     "description": "CORS rule letting browsers on Plane's domain upload to / read from the bucket with presigned URLs. Add custom domains to AllowedOrigins and redeploy this service.",
     "required": false
    }
   }
